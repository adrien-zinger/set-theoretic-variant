#!/usr/bin/env bash
set -e
if [[ ! -d "/home/azinger/Documents/projects/hindley_milner_rs" ]]; then
  echo "Cannot find source directory; Did you move it?"
  echo "(Looking for "/home/azinger/Documents/projects/hindley_milner_rs")"
  echo 'Cannot force reload with this script - use "direnv reload" manually and then try again'
  exit 1
fi

# rebuild the cache forcefully
_nix_direnv_force_reload=1 direnv exec "/home/azinger/Documents/projects/hindley_milner_rs" true

# Update the mtime for .envrc.
# This will cause direnv to reload again - but without re-building.
touch "/home/azinger/Documents/projects/hindley_milner_rs/.envrc"

# Also update the timestamp of whatever profile_rc we have.
# This makes sure that we know we are up to date.
touch -r "/home/azinger/Documents/projects/hindley_milner_rs/.envrc" "/home/azinger/Documents/projects/hindley_milner_rs/.direnv"/*.rc
